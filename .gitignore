__pycache__/
*.pyc
.venv/
venv/
.DS_Store

# Python build artifacts
dist/
build/
*.egg-info/

# tools/dashboard.py output. Local by design: it reads every project's memory,
# including private repos and ones with no remote, so the rendered file must not
# travel. Regenerate with `python tools/dashboard.py`.
dashboard.html

# EVERYTHING cambium writes into this repo. All of it is either a build artifact
# derived from .context/ stores (pages, snapshot, exported page markdown) or the
# LOCAL knowledge store — and every one of them spans whatever projects are named
# in CAMBIUM_PROJECTS, including private repos and ones with no remote. That is
# what con-015-12da forbids, and it notes the failure cannot be reliably
# unpublished once pushed.
#
# The whole DIRECTORY, deliberately, because this file previously enumerated
# individual names and had already drifted narrower than the rule it restates:
# export_pages' default output (.cambium/pages/*.md, full entry prose from every
# named project) was unignored, and docs/model-written-pages.md names a future
# .cambium/essays.json that would have been too. `.cambium/` is also exactly what
# setup()'s _ensure_gitignored writes, so there is now one authority for it.
#
# DESIGN calls local scope "yours; not shared" — but local scope lives in the
# project repo and this repo is public, so those two statements contradict each
# other. Knowledge that should travel goes to team or org scope, which have their
# own repos and their own gates. Local stays on the machine.
.cambium/

# Mirror byproducts: a retry queue, a conflict log and retrieval telemetry.
# The store itself (.context/decisions.json, constraints.json) IS tracked; these
# are per-machine and rewritten constantly.
.context/usage.json
.context/mirror.log
.context/.mirror_conflicts.json
.context/embeddings.json
