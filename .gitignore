__pycache__/
*.pyc
.venv/
venv/
.DS_Store

# Python build artifacts
dist/
build/
*.egg-info/

# tools/dashboard.py output. Local by design: it reads every project's memory,
# including private repos and ones with no remote, so the rendered file must not
# travel. Regenerate with `python tools/dashboard.py`.
dashboard.html

# Compiled pages and the mesh snapshot. Both are BUILD ARTIFACTS derived from
# .context/ stores — regenerate with compile_project / export-snapshot. They are
# gitignored for two independent reasons: a snapshot spans every project named
# in CAMBIUM_PROJECTS, including private repos and ones with no remote (the same
# rule that keeps dashboard.html local, and con-015-12da in context-keeper), and
# a page carries a compiled_at that would churn this repo's history on every
# rebuild while adding nothing the entries do not already say.
.cambium/pages.json
.cambium/snapshot.json

# The LOCAL knowledge store. DESIGN calls local scope "yours; not shared" — but
# local scope lives in the project repo, and THIS project repo is public, so
# "not shared" and "committed here" are in direct contradiction. It was tracked
# while it happened to be empty; the moment it held real captures it carried
# dozens of references to other projects on the machine, including one with no
# remote at all — precisely what con-015-12da forbids, and that constraint notes
# the failure cannot be reliably unpublished once pushed.
# Knowledge that should travel goes to team or org scope, which have their own
# repos and their own gates. Local stays on the machine.
.cambium/knowledge.json

# Mirror byproducts: a retry queue, a conflict log and retrieval telemetry.
# The store itself (.context/decisions.json, constraints.json) IS tracked; these
# are per-machine and rewritten constantly.
.context/usage.json
.context/mirror.log
.context/.mirror_conflicts.json
.context/embeddings.json
